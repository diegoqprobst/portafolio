{
  "name": "kelvin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "npx --yes vercel@64 build && npx --yes vercel@64 deploy --prebuilt",
    "deploy:netlify": "npx --yes netlify-cli@27 deploy --build",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name kelvin",
    "test": "vitest run",
    "colorstrip": "tsx scripts/build-colorstrip.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@videojs/core": "10.3.0",
    "@videojs/react": "10.3.0",
    "cn": "^0.4.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
